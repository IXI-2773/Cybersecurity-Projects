# Fabricated iptables-save -t filter output; no real firewall was queried.
*filter
:INPUT DROP [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]
-A INPUT -s 10.10.0.0/24 -d 10.10.1.5/32 -p tcp -m tcp --dport 22 -j ACCEPT
-A INPUT -s 0.0.0.0/0 -d 10.10.1.20/32 -p tcp -m tcp --dport 3389 -j ACCEPT
-A INPUT -j ACCEPT
-A FORWARD -j DROP
COMMIT
